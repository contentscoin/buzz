{
  "id": "fmg-supervisor",
  "name": "FMG Dot Supervisor",
  "version": "0.7.0",
  "description": "Owner verified Buzz observations and directly approved durable task execution for Your dot.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "ownerPubkey": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "telegramOwnerId": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,19}$"
      },
      "operatorUrl": {
        "type": "string",
        "const": "http://fmg-dot-supervisor:8001/operator"
      },
      "tokenFile": {
        "type": "string",
        "const": "/data/.openclaw/secrets/fmg-supervisor-operator.token"
      }
    },
    "required": [
      "ownerPubkey"
    ],
    "additionalProperties": false
  },
  "contracts": {
    "tools": [
      "fmg_buzz_gateway_status",
      "fmg_buzz_gateway_get_task",
      "fmg_buzz_gateway_list_tasks"
    ]
  },
  "toolMetadata": {
    "fmg_buzz_gateway_status": {
      "optional": true
    },
    "fmg_buzz_gateway_get_task": {
      "optional": true
    },
    "fmg_buzz_gateway_list_tasks": {
      "optional": true
    }
  }
}
