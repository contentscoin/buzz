{
  "id": "fmg-supervisor",
  "name": "FMG Dot Supervisor",
  "version": "0.3.0",
  "description": "Owner verified Buzz observations and directly approved durable task execution for Your dot.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "ownerPubkey": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "telegramOwnerId": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,19}$"
      },
      "operatorUrl": {
        "type": "string",
        "const": "http://fmg-dot-supervisor:8001/operator"
      },
      "tokenFile": {
        "type": "string",
        "const": "/data/.openclaw/secrets/fmg-supervisor-operator.token"
      }
    },
    "required": ["ownerPubkey"],
    "additionalProperties": false
  }
}
