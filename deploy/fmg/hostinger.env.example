BUZZ_SPRIG_GIT_SHA=598d6aad833c755dbdedcddfeca8efaed0defb49
BUZZ_SPRIG_SHA256=0d4c4fd86621734c6f3b640deab3eb6cd00e647eeb7639441ea37f3a40c4bfb0
BUZZ_SPRIG_EXECUTABLE_SHA256=c0dc492a5fd9eb1543472cfd57daa6a25da68707e3efcbfeef0cf342a821c773

# Aside browser automation is opt-in. Empty is the implemented OFF state.
BUZZ_ACP_ASIDE_COMMAND=

# Keep credentials, private keys, database URLs and provider tokens in
