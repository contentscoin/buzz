# FMG Buzz public endpoints (not secrets)
RELAY_URL=wss://buzz-dnb0.srv2006121.hstgr.cloud
BUZZ_RELAY_URL=wss://buzz-dnb0.srv2006121.hstgr.cloud
BUZZ_CORS_ORIGINS=https://buzz-dnb0.srv2006121.hstgr.cloud,tauri://localhost,http://tauri.localhost

# Pin the Hostinger deployment to the digest produced from the release commit.
# Replace the placeholder only after recording the digest in the release receipt.
BUZZ_IMAGE=ghcr.io/contentscoin/buzz@sha256:<64-hex-digest>

# Pin the ACP archive independently from its GitHub release URL. Record these
# from the successful same-commit Sprig workflow before redeploying Hostinger.
BUZZ_SPRIG_VERSION=0.5.26-fmg.1
BUZZ_SPRIG_GIT_SHA=<40-hex-reviewed-main-commit>
BUZZ_SPRIG_SHA256=<64-hex-archive-sha256>

# Aside browser automation is opt-in. Empty is the implemented OFF state.
BUZZ_ACP_ASIDE_COMMAND=

# Keep credentials, private keys, database URLs and provider tokens in
# Hostinger secrets. Do not add them to this file or the repository.
